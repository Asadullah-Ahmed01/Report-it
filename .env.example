# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Shared database (leave empty to use local db.sqlite3), e.g.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DJANGO_DEBUG=1
# Login. JUDGE_MODE=1 keeps the hackathon's one-click, no-password user switcher.
# Set JUDGE_MODE=0 to require sign-in through the student / staff / admin portals.
JUDGE_MODE=1
DEMO_PASSWORD=CodeQuest26!
ADMIN_PASSWORD=Registrar@26
# Set a long random value when deployed:
DJANGO_SECRET_KEY=
